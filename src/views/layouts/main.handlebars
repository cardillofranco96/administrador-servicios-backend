<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{title}}</title>
    <script src="/socket.io/socket.io.js"></script>
    <style>
      :root {
        --bg: #0b0b0f;
        --panel: rgba(18, 18, 24, 0.9);
        --panel-strong: #1a1a22;
        --card: rgba(22, 22, 29, 0.94);
        --line: rgba(255,255,255,0.08);
        --text: #f5f5f5;
        --muted: #d9d9d9;
        --orange: #ff8a00;
        --orange-soft: #ffb14a;
        --red: #ff4d4d;
        --shadow: rgba(255, 102, 0, 0.28);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        font-family: Arial, Helvetica, sans-serif;
        background:
          radial-gradient(circle at top left, rgba(255,111,0,0.2), transparent 25%),
          radial-gradient(circle at bottom right, rgba(255, 61, 61, 0.18), transparent 28%),
          linear-gradient(135deg, #090909 0%, #16161a 45%, #0b0b0f 100%);
        color: var(--text);
      }

      a { color: inherit; text-decoration: none; }

      .page-shell {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px 80px;
      }

      .topbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 28px;
        padding: 18px 24px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(18, 18, 24, 0.7);
        box-shadow: 0 10px 30px rgba(0,0,0,0.25);
        backdrop-filter: blur(8px);
      }

      .brand {
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--orange-soft);
      }

      .nav {
        display: flex;
        gap: 18px;
        align-items: center;
        font-size: 0.95rem;
        color: var(--muted);
      }

      .nav a {
        transition: color 0.2s ease;
      }

      .nav a:hover {
        color: var(--orange-soft);
      }

      .primary-btn, .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        padding: 12px 18px;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .primary-btn {
        background: linear-gradient(135deg, var(--orange), var(--red));
        color: white;
        box-shadow: 0 14px 28px var(--shadow);
      }

      .secondary-btn {
        border: 1px solid rgba(255,255,255,0.1);
        background: rgba(255,255,255,0.02);
        color: var(--text);
      }

      .primary-btn:hover, .secondary-btn:hover {
        transform: translateY(-2px);
      }

      .hero {
        display: grid;
        grid-template-columns: 1.4fr 0.9fr;
        gap: 24px;
        align-items: center;
        margin-bottom: 42px;
      }

      .hero-panel, .info-panel, .service-card, .contact-card {
        background: linear-gradient(180deg, rgba(30,30,36,0.95), rgba(12,12,16,0.92));
        border: 1px solid var(--line);
        border-radius: 26px;
        box-shadow: 0 18px 35px rgba(0,0,0,0.22);
      }

      .hero-panel {
        padding: 36px;
      }

      .eyebrow {
        color: var(--orange-soft);
        text-transform: uppercase;
        letter-spacing: 0.12em;
        font-size: 0.8rem;
        font-weight: 700;
      }

      h1 {
        margin: 14px 0 16px;
        font-size: clamp(2.2rem, 4vw, 4rem);
        line-height: 1.04;
      }

      .subtitle {
        color: var(--muted);
        font-size: 1.08rem;
        line-height: 1.7;
        max-width: 600px;
      }

      .cta-row {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 24px;
      }

      .info-panel {
        padding: 28px;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(120px, 1fr));
        gap: 16px;
        margin-top: 22px;
      }

      .stat {
        padding: 16px 14px;
        border-radius: 18px;
        background: rgba(255,255,255,0.02);
        border: 1px solid var(--line);
      }

      .stat strong {
        display: block;
        font-size: 1.5rem;
        color: var(--orange-soft);
      }

      .stat span {
        color: var(--muted);
        font-size: 0.9rem;
      }

      .card-section {
        margin-top: 14px;
      }

      .section-head {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 20px;
      }

      .section-head h2 {
        margin: 0;
        font-size: clamp(1.7rem, 2vw, 2.4rem);
      }

      .section-head span {
        color: var(--orange-soft);
        font-weight: 700;
      }

      .service-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 18px;
      }

      .service-card {
        position: relative;
        overflow: hidden;
        padding: 22px 20px;
        transition: transform 0.25s ease, border-color 0.25s ease;
      }

      .service-card:hover {
        transform: translateY(-6px);
        border-color: rgba(255, 138, 0, 0.4);
      }

      .service-card::before {
        content: "";
        position: absolute;
        inset: 0 auto auto 0;
        width: 100%;
        height: 3px;
        background: linear-gradient(90deg, var(--orange), var(--red));
      }

      .badge {
        display: inline-block;
        margin-bottom: 12px;
        padding: 6px 10px;
        border-radius: 999px;
        background: rgba(255, 138, 0, 0.14);
        color: var(--orange-soft);
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }

      .service-card h3 {
        margin: 0 0 10px;
        font-size: 1.2rem;
      }

      .service-card p {
        margin: 0;
        color: var(--muted);
        line-height: 1.6;
      }

      .meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 20px;
        font-size: 0.9rem;
        color: var(--muted);
      }

      .price {
        color: var(--orange-soft);
        font-weight: 700;
        font-size: 1.1rem;
      }

      .contact-card {
        margin-top: 28px;
        padding: 28px;
        text-align: center;
      }

      .contact-card p {
        color: var(--muted);
        line-height: 1.7;
      }

      .socials {
        display: flex;
        justify-content: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 16px;
      }

      .socials a {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 180px;
        padding: 12px 16px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,0.08);
        background: rgba(255,255,255,0.02);
        color: var(--text);
        font-weight: 700;
      }

      .empty-state {
        padding: 18px 20px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: rgba(255,255,255,0.02);
        color: var(--muted);
      }

      @media (max-width: 800px) {
        .hero {
          grid-template-columns: 1fr;
        }

        .topbar {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-shell">
      <header class="topbar">
        <div class="brand">Circuito IT</div>
        <nav class="nav">
          <a href="/">Inicio</a>
          <a href="/services">Servicios</a>
          <a href="https://www.linkedin.com/in/cardillofranco/" target="_blank" rel="noreferrer">LinkedIn</a>
          <a href="https://github.com/cardillofranco96" target="_blank" rel="noreferrer">GitHub</a>
        </nav>
      </header>

      {{{body}}}
    </div>
  </body>
</html>
