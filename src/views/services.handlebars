<div class="card">
  <h1>{{title}}</h1>
  {{#if services.length}}
    <ul>
      {{#each services}}
        <li>
          <strong>{{this.name}}</strong> - {{this.category}}<br>
          {{this.description}}<br>
          Duración: {{this.duration}} min | Precio: ${{this.price}}
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p>No hay servicios disponibles.</p>
  {{/if}}

  <p><a href="/">Volver al inicio</a></p>
</div>
