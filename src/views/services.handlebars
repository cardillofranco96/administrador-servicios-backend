<h1>Servicios</h1>
<a href="/views/availability">Ver reservas</a>
<ul id="services-list">
  {{#each services}}
    <li data-id="{{id}}">
      <strong>{{name}}</strong> - {{description}}<br>
      Duración: {{duration}} min · Precio: ${{price}} · Categoría: {{category}} · Disponible: {{available}}
    </li>
  {{/each}}
</ul>
